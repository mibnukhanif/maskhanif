<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="certBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#fffbeb" />
    </linearGradient>
  </defs>
  <rect width="800" height="600" fill="#f8fafc" />
  <rect x="40" y="40" width="720" height="520" rx="16" fill="url(#certBg)" stroke="#fdb60c" stroke-width="8" />
  <rect x="56" y="56" width="688" height="488" rx="10" fill="none" stroke="#222222" stroke-width="2" stroke-dasharray="8 6" />
  <g transform="translate(400, 130)" text-anchor="middle">
    <circle cx="0" cy="0" r="32" fill="#fdb60c" />
    <path d="M -12 25 L -20 60 L 0 45 L 20 60 L 12 25 Z" fill="#d97706" />
    <polygon points="0,-16 5,-5 16,-5 8,3 11,14 0,7 -11,14 -8,3 -16,-5 -5,-5" fill="#222222" />
    <text x="0" y="70" font-family="'Poppins', sans-serif" font-size="28" font-weight="900" fill="#222222" letter-spacing="2">SERTIFIKAT KOMPETENSI</text>
    <text x="0" y="100" font-family="'Montserrat', sans-serif" font-size="14" font-weight="600" fill="#64748b">Diberikan kepada:</text>
    <text x="0" y="150" font-family="'Poppins', sans-serif" font-size="34" font-weight="900" fill="#fdb60c">IBNU KHANIF</text>
    <line x1="-180" y1="165" x2="180" y2="165" stroke="#222222" stroke-width="2" />
    <text x="0" y="200" font-family="'Montserrat', sans-serif" font-size="16" font-weight="500" fill="#334155">Atas keberhasilan menyelesaikan pelatihan resmi:</text>
    <text x="0" y="235" font-family="'Poppins', sans-serif" font-size="20" font-weight="bold" fill="#222222">Aplikasi Perkantoran Level 3 KKNI</text>
    <text x="0" y="265" font-family="'Montserrat', sans-serif" font-size="13" font-weight="600" fill="#f59e0b">Standar Kompetensi Kerja Nasional Indonesia</text>
